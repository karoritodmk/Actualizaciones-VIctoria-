uvicorn main:app --reload# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el ".env" real a un repositorio.

# --- Base de datos ---
# Postgres:  postgresql://usuario:password@host:5432/victoria
DATABASE_URL=postgresql://postgres:password@localhost:5432/victoria

# --- Seguridad / JWT ---
SECRET_KEY=3077963d613adaf1a1a782f7cae9eac7bde20d5c597eac9db0c5f6d3ee8ee5d2
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS ---
# Déjalo vacío si solo usas el login web (mismo origen). Si conectas la
# app móvil (appm) en desarrollo o un frontend separado, agrega su origen
# separado por comas, ej: http://localhost:8081,http://localhost:19006
ALLOWED_ORIGINS=

# --- Correo (recuperación de contraseña) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM_NAME=VICTORIA - SENA
